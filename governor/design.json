{
  "silver_models": [
    {
      "name": "stg_customers",
      "folder": "staging",
      "source_table": "olist_customers_dataset",
      "refs": [],
      "description": "Staging of raw customers table: typed columns kept, no enrichment. One row per raw customer_id.",
      "primary_key": [
        "customer_id"
      ],
      "columns": [
        {
          "name": "customer_id",
          "expr": "NULLIF(customer_id, '')",
          "type": "text",
          "pii": true,
          "description": "raw customer_id (business key)"
        },
        {
          "name": "customer_unique_id",
          "expr": "NULLIF(customer_unique_id, '')",
          "type": "text",
          "pii": true,
          "description": "person-level customer key"
        },
        {
          "name": "customer_zip_code_prefix",
          "expr": "NULLIF(customer_zip_code_prefix, '')",
          "type": "text",
          "pii": true,
          "description": "zip code prefix"
        },
        {
          "name": "customer_city",
          "expr": "NULLIF(customer_city, '')",
          "type": "text",
          "pii": true,
          "description": "city"
        },
        {
          "name": "customer_state",
          "expr": "NULLIF(customer_state, '')",
          "type": "text",
          "pii": true,
          "description": "state"
        }
      ]
    },
    {
      "name": "stg_orders",
      "folder": "staging",
      "source_table": "olist_orders_dataset",
      "refs": [],
      "description": "Staging of raw orders: typed timestamps and status. One row per raw order_id.",
      "primary_key": [
        "order_id"
      ],
      "columns": [
        {
          "name": "order_id",
          "expr": "NULLIF(order_id, '')",
          "type": "text",
          "pii": false,
          "description": "order identifier"
        },
        {
          "name": "customer_id",
          "expr": "NULLIF(customer_id, '')",
          "type": "text",
          "pii": true,
          "description": "customer_id (per-order id), used to join to customers for person key"
        },
        {
          "name": "order_status",
          "expr": "NULLIF(order_status, '')",
          "type": "text",
          "pii": false,
          "description": "order lifecycle status (e.g. delivered, canceled, unavailable, etc.)"
        },
        {
          "name": "order_purchase_timestamp",
          "expr": "CAST(NULLIF(order_purchase_timestamp, '') AS timestamp)",
          "type": "timestamp",
          "pii": false,
          "description": "purchase timestamp"
        },
        {
          "name": "order_approved_at",
          "expr": "CAST(NULLIF(order_approved_at, '') AS timestamp)",
          "type": "timestamp",
          "pii": false,
          "description": "approval timestamp"
        },
        {
          "name": "order_delivered_carrier_date",
          "expr": "CAST(NULLIF(order_delivered_carrier_date, '') AS timestamp)",
          "type": "timestamp",
          "pii": false,
          "description": "delivered to carrier timestamp"
        },
        {
          "name": "order_delivered_customer_date",
          "expr": "CAST(NULLIF(order_delivered_customer_date, '') AS timestamp)",
          "type": "timestamp",
          "pii": false,
          "description": "delivered to customer timestamp"
        },
        {
          "name": "order_estimated_delivery_date",
          "expr": "CAST(NULLIF(order_estimated_delivery_date, '') AS timestamp)",
          "type": "timestamp",
          "pii": false,
          "description": "estimated delivery date"
        }
      ]
    },
    {
      "name": "stg_order_items",
