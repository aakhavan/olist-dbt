  ],
  "kpis": [
    {
      "id": "gmv",
      "decision": "build",
      "domain": "sales",
      "mapping": {
        "order_lines": "int_order_lines",
        "purchased_at": "purchased_at",
        "item_price": "item_price",
        "freight": "freight",
        "valid_order": "order_status NOT IN ('canceled', 'unavailable')"
      }
    },
    {
      "id": "net_revenue",
      "decision": "build",
      "domain": "sales",
      "mapping": {
        "order_lines": "int_order_lines",
        "purchased_at": "purchased_at",
        "item_price": "item_price",
        "delivered_order": "order_status = 'delivered'"
      }
    },
    {
      "id": "aov",
      "decision": "build",
      "domain": "sales",
      "mapping": {
        "order_lines": "int_order_lines",
        "order_id": "order_id",
        "purchased_at": "purchased_at",
        "item_price": "item_price",
        "valid_order": "order_status NOT IN ('canceled', 'unavailable')"
      }
    },
    {
      "id": "on_time_delivery_rate",
      "decision": "build",
      "domain": "delivery",
      "mapping": {
        "orders": "int_orders",
        "purchased_at": "purchased_at",
        "delivered_at": "delivered_at",
        "estimated_at": "estimated_at",
        "delivered_order": "order_status = 'delivered'"
      }
    },
    {
      "id": "avg_review_score",
      "decision": "build",
      "domain": "customers",
      "mapping": {
        "order_reviews": "int_order_reviews",
        "purchased_at": "purchased_at",
        "review_score": "review_score"
      }
    },
    {
      "id": "repeat_purchase_rate",
      "decision": "build",
      "domain": "customers",
      "mapping": {
        "orders": "int_orders",
        "order_id": "order_id",
        "customer_key": "customer_key",
        "valid_order": "order_status NOT IN ('canceled', 'unavailable')"
      }
    },
    {
      "id": "cohort_retention",
      "decision": "build",
      "domain": "customers",
      "mapping": {
        "orders": "int_orders",
        "customer_key": "customer_key",
        "purchased_at": "purchased_at",
        "valid_order": "order_status NOT IN ('canceled', 'unavailable')"
      }
    },
    {
      "id": "historical_clv",
      "decision": "build",
      "domain": "customers",
      "mapping": {
        "order_lines": "int_order_lines",
        "customer_key": "customer_key",
        "purchased_at": "purchased_at",
        "item_price": "item_price",
        "valid_order": "order_status NOT IN ('canceled', 'unavailable')",
        "delivered_order": "order_status = 'delivered'"
      }
    },
    {
      "id": "conversion_rate",
      "decision": "decline",
      "reason": "No sessions / web analytics data in the raw profile; cannot compute sessions or session-level conversion.",
      "gap": {
        "missing": [
          "sessions table with one row per site session including session_start timestamp and converted boolean"
        ],
        "typical_sources": [
          "Web analytics (Google Analytics 4, Adobe Analytics), tracking pipeline, cookie/session logs, backend visit events"
        ],
        "next_step": "Load a sessions (or visits) table with a session_start timestamp and a boolean converted flag (or linkable events that allow deriving converted)."
      }
    },
    {
      "id": "gross_margin",
      "decision": "decline",
      "reason": "No product cost data (product_costs) is available in the raw profile; cannot compute gross margin without unit cost.",
      "gap": {
        "missing": [
          "product_costs table with product_key and unit_cost"
        ],
        "typical_sources": [
          "ERP, PIM, procurement system, vendor price lists"
        ],
        "next_step": "Load a product_costs table keyed by product_id (or the product_key used in order_lines) with a numeric unit_cost column."
      }
    }
  ],
  "assumptions": [
    "Person-level customer key = stg_customers.customer_unique_id and is the canonical 'customer_key' used by customer-facing KPIs.",
    "A valid order = order_status NOT IN ('canceled', 'unavailable'). This matches approved mappings.",
    "A delivered order = order_status = 'delivered'. This matches approved mappings.",
    "int_order_reviews picks the latest review per order by review_answer_timestamp (ties resolved arbitrarily by order in SQL window).",
    "int_orders is built by joining stg_orders to stg_customers on customer_id to obtain customer_unique_id; stg_orders.order_id is the order grain.",
    "PII columns (customer_id, customer_unique_id, zip/city) are tagged in silver; gold models must mask or exclude them per blueprint rules.",
    "Source_table names must match the raw profile table names exactly (e.g. 'olist_orders_dataset'), not schema-qualified strings used previously."
  ]
}
