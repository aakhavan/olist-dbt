  "kpis": [
    {
      "id": "gmv",
      "decision": "build",
      "domain": "sales",
      "mapping": {
        "order_lines": "int_order_lines",
        "purchased_at": "purchased_at",
        "item_price": "item_price",
        "freight": "freight",
        "valid_order": "order_status NOT IN ('canceled', 'unavailable')"
      }
    },
    {
      "id": "net_revenue",
      "decision": "build",
      "domain": "sales",
      "mapping": {
        "order_lines": "int_order_lines",
        "purchased_at": "purchased_at",
        "item_price": "item_price",
        "delivered_order": "order_status = 'delivered'"
      }
    },
    {
      "id": "aov",
      "decision": "build",
      "domain": "sales",
      "mapping": {
        "order_lines": "int_order_lines",
        "order_id": "order_id",
        "purchased_at": "purchased_at",
        "item_price": "item_price",
        "valid_order": "order_status NOT IN ('canceled', 'unavailable')"
      }
    },
    {
      "id": "on_time_delivery_rate",
      "decision": "build",
      "domain": "delivery",
      "mapping": {
        "orders": "int_orders",
        "purchased_at": "purchased_at",
        "delivered_at": "delivered_at",
        "estimated_at": "estimated_at",
        "delivered_order": "order_status = 'delivered'"
      }
    },
    {
      "id": "avg_review_score",
      "decision": "build",
      "domain": "customers",
      "mapping": {
        "order_reviews": "int_order_reviews",
        "purchased_at": "purchased_at",
        "review_score": "review_score"
      }
    },
    {
      "id": "repeat_purchase_rate",
      "decision": "build",
      "domain": "customers",
      "mapping": {
        "orders": "int_orders",
        "order_id": "order_id",
        "customer_key": "customer_key",
        "valid_order": "order_status NOT IN ('canceled', 'unavailable')"
      }
    },
    {
      "id": "cohort_retention",
      "decision": "build",
      "domain": "customers",
      "mapping": {
        "orders": "int_orders",
        "customer_key": "customer_key",
        "purchased_at": "purchased_at",
        "valid_order": "order_status NOT IN ('canceled', 'unavailable')"
      }
    },
    {
      "id": "historical_clv",
      "decision": "build",
      "domain": "customers",
      "mapping": {
        "order_lines": "int_order_lines",
        "customer_key": "customer_key",
        "purchased_at": "purchased_at",
        "item_price": "item_price",
        "valid_order": "order_status NOT IN ('canceled', 'unavailable')",
        "delivered_order": "order_status = 'delivered'"
      }
    },
    {
      "id": "conversion_rate",
      "decision": "decline",
      "reason": "No sessions/visits data is present in the raw tables; KPI requires session-level data.",
      "gap": {
        "missing": [
          "sessions table (session id, session_start timestamp, converted boolean)"
        ],
        "typical_sources": [
          "web analytics (GA4 export), Snowplow, Segment or other event tracking capturing sessions/visits"
        ],
        "next_step": "Ingest session or event-level visit data including session_start and a converted flag or joinable purchase events so sessions can be counted and labelled as converted."
      }
    },
    {
      "id": "gross_margin",
      "decision": "decline",
      "reason": "No product cost or COGS data available to compute margin; KPI requires unit cost per product.",
      "gap": {
        "missing": [
          "product_costs table with product_id (or product_key) and unit_cost"
        ],
        "typical_sources": [
          "ERP, PIM, procurement system, or accounting exports containing product unit costs"
        ],
        "next_step": "Load product-level cost data (product_id -> unit_cost) so cost of goods sold can be computed and joined to order lines."
      }
    }
  ],
  "assumptions": [
    "Person-level customer key = stg_customers.customer_unique_id; int_orders.customer_key surfaces that value and is the person-level identifier used by customer KPIs.",
    "An order counts as a valid sale when order_status NOT IN ('canceled', 'unavailable'). This is used for valid_order filters across KPIs.",
    "A delivered order is order_status = 'delivered'.",
    "int_orders.delivered_at uses stg_orders.order_delivered_customer_date (customer delivery timestamp) as the delivered timestamp for delivery KPIs.",
    "int_order_reviews contains one row per order by selecting the stg_order_reviews row with the greatest review_answer_timestamp for that order_id (latest review/answer).",
    "int_order_lines is one row per original order item (grain order_id + order_item_id) and is built by joining stg_order_items to int_orders on order_id to bring in purchase timestamp, order_status, and customer_key.",
    "PII columns are flagged in silver; customer_key in intermediate models remains marked PII and should be masked/excluded in gold per blueprint rules.",
    "Where multiple raw candidate keys exist, staging primary keys use stable business keys (e.g., order_id for orders, product_id for products, order_id+order_item_id for order items)."
  ]
}
